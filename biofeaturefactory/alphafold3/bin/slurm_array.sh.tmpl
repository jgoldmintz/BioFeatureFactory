#!/bin/bash
# AF3 burst-mode SLURM array script.
#
# Generated by biofeaturefactory.alphafold3.burst submit. Each array task
# runs one AF3 prediction (one (rna_seq, protein_seq) input hash) via the
# AlphaFold3 Docker image, exactly as documented in the official AF3
# installation guide (alphafold3/docs/installation.md), with the BFF-specific
# additions:
#   - --norun_data_pipeline (per BFF README: BFF skips AF3's genetic DB
#     pipeline; MSAs are baked into the input JSON via --msa-dir).
#   - No --db_dir flag, no public_databases volume mount (BFF stops AF3 setup
#     before "Obtaining Genetic Databases").
#   - Per-task GPU pinning via $CUDA_VISIBLE_DEVICES (SLURM's allocation),
#     with --gpus all as the manual-test fallback.
#
# Substitution points (replaced by burst.py at template render time):
#   __JOB_NAME__     SLURM job name
#   __PARTITION__    SLURM partition
#   __TIME__         per-task wall-time limit (e.g. 01:00:00)
#   __MEM__          per-task memory (e.g. 64G)
#   __LOG_DIR__      directory for slurm-%A_%a.out / .err
#   __MANIFEST__     absolute path to manifest.tsv
#   __MODEL_DIR__    absolute path to AF3 model weights
#   __DOCKER_IMAGE__ Docker image name (default: alphafold3)
#   __PYTHON_BIN__    Python interpreter used to invoke the cache helper
#   __CACHE_HELPER__  absolute path to burst_manifest.py

#SBATCH --job-name=__JOB_NAME__
#SBATCH --partition=__PARTITION__
#SBATCH --time=__TIME__
#SBATCH --gpus=1
#SBATCH --mem=__MEM__
#SBATCH --output=__LOG_DIR__/slurm-%A_%a.out
#SBATCH --error=__LOG_DIR__/slurm-%A_%a.err

set -euo pipefail

MANIFEST="__MANIFEST__"
MODEL_DIR="__MODEL_DIR__"
DOCKER_IMAGE="__DOCKER_IMAGE__"
PYTHON_BIN="__PYTHON_BIN__"
CACHE_HELPER="__CACHE_HELPER__"
CACHE_GENERATION="__CACHE_GENERATION__"

# Manifest layout: line 1 = comment header, line 2 = column header,
# data rows start at line 3. SLURM_ARRAY_TASK_ID is 0-indexed.
LINE=$((SLURM_ARRAY_TASK_ID + 3))
ROW=$(sed -n "${LINE}p" "$MANIFEST")
if [ -z "$ROW" ]; then
    echo "ERR: no manifest row at array idx $SLURM_ARRAY_TASK_ID (line $LINE)" >&2
    exit 2
fi

INPUT_HASH=$(echo "$ROW" | cut -f2)
INPUT_JSON=$(echo "$ROW" | cut -f7)
CACHE_DIR=$(echo  "$ROW" | cut -f8)
OUTPUT_NAME=$(echo "$ROW" | cut -f9)

if [ -z "$OUTPUT_NAME" ]; then
    echo "ERR: manifest row has no AF3 output name" >&2
    exit 2
fi

# Idempotent cache hit check uses the exact same predicate as submit/ingest.
if "$PYTHON_BIN" "$CACHE_HELPER" check "$CACHE_DIR" "$OUTPUT_NAME"; then
    echo "Cache hit for $INPUT_HASH; skipping" >&2
    exit 0
else
    CACHE_STATUS=$?
    if [ "$CACHE_STATUS" -ne 1 ]; then
        echo "ERR: cache helper failed with status $CACHE_STATUS" >&2
        exit "$CACHE_STATUS"
    fi
fi

INPUT_DIR=$(dirname  "$INPUT_JSON")
INPUT_FILE=$(basename "$INPUT_JSON")

# AF3 outputs are staged beside the destination so the shared helper can
# validate and publish with a same-filesystem atomic rename.
CACHE_PARENT=$(dirname "$CACHE_DIR")
mkdir -p "$CACHE_PARENT"
TMP_OUT=$("$PYTHON_BIN" "$CACHE_HELPER" stage "$CACHE_DIR" "$CACHE_GENERATION")

preserve_incomplete() {
    exit_status=$?
    trap - EXIT
    if [ -d "$TMP_OUT" ]; then
        partial_base="${TMP_OUT}.incomplete-${SLURM_JOB_ID:-manual}-${SLURM_ARRAY_TASK_ID:-0}-$$"
        partial_path="$partial_base"
        partial_index=0
        while [ -e "$partial_path" ]; do
            partial_index=$((partial_index + 1))
            partial_path="${partial_base}-${partial_index}"
        done
        if mv -- "$TMP_OUT" "$partial_path"; then
            echo "Preserved incomplete AF3 output at $partial_path" >&2
        else
            echo "WARN: could not preserve incomplete AF3 output at $TMP_OUT" >&2
        fi
    fi
    exit "$exit_status"
}
trap preserve_incomplete EXIT

# GPU selection: respect SLURM's allocation when running under SLURM. Fall
# back to --gpus all for manual testing outside SLURM. nvidia-container-toolkit
# reads NVIDIA_VISIBLE_DEVICES from --gpus, so this correctly fences the
# container to the SLURM-allocated GPU on shared multi-GPU nodes.
GPU_FLAG="all"
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    GPU_FLAG="device=${CUDA_VISIBLE_DEVICES}"
fi

# AF3 docker invocation, faithful to alphafold3/docs/installation.md:303-313.
# Volume mounts and AF3 flags match the official docs exactly except:
#   + --rm (batch hygiene, not contradicted by docs)
#   + --norun_data_pipeline (per BFF use case; MSAs are in the input JSON)
#   - no --volume <DB_DIR>:/root/public_databases (BFF skips genetic DBs)
#   - no --db_dir flag passed to run_alphafold.py (same reason)
#   - no -it (non-interactive batch)
# XLA env vars (XLA_FLAGS, XLA_PYTHON_CLIENT_PREALLOCATE, XLA_CLIENT_MEM_FRACTION)
# are set by AF3's Dockerfile via ENV, so we don't pass them on the command line.
docker run --rm \
    --volume "$INPUT_DIR":/root/af_input \
    --volume "$TMP_OUT":/root/af_output \
    --volume "$MODEL_DIR":/root/models \
    --gpus "$GPU_FLAG" \
    "$DOCKER_IMAGE" \
    python run_alphafold.py \
        --json_path=/root/af_input/"$INPUT_FILE" \
        --model_dir=/root/models \
        --output_dir=/root/af_output \
        --norun_data_pipeline

# Validation, writer serialization, stale-destination quarantine, and atomic
# publication all live in the shared Python helper.
"$PYTHON_BIN" "$CACHE_HELPER" publish "$TMP_OUT" "$CACHE_DIR" "$OUTPUT_NAME"
trap - EXIT

echo "Wrote AF3 output for $INPUT_HASH to $CACHE_DIR" >&2
